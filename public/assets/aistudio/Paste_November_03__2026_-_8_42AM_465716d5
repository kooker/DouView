### 七、 主控制台 `MainActivity.kt` 核心实现

实现功能：
1. **ExoPlayer 初始化与全生命周期绑定**。
2. **后台协程定时轮询探活（对应前端 25s 轮询）**。
3. **根据开播状态动态置顶与重排**。

```kotlin
package com.example.douyinlive

import android.os.Bundle
import android.view.View
import android.view.WindowManager
import android.widget.Toast
import androidx.appcompat.app.AppCompatActivity
import androidx.lifecycle.lifecycleScope
import androidx.media3.common.MediaItem
import androidx.media3.common.PlaybackException
import androidx.media3.common.Player
import androidx.media3.exoplayer.ExoPlayer
import androidx.recyclerview.widget.LinearLayoutManager
import androidx.room.Room
import com.bumptech.glide.Glide
import com.example.douyinlive.data.AppDatabase
import com.example.douyinlive.data.ChannelEntity
import com.example.douyinlive.databinding.ActivityMainBinding
import com.example.douyinlive.engine.DouyinLiveEngine
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.Job
import kotlinx.coroutines.delay
import kotlinx.coroutines.isActive
import kotlinx.coroutines.launch
import kotlinx.coroutines.withContext

class MainActivity : AppCompatActivity() {

    private lateinit var binding: ActivityMainBinding
    private var exoPlayer: ExoPlayer? = null
    private lateinit var db: AppDatabase
    private val channelList = mutableListOf<ChannelEntity>()
    private lateinit var adapter: ChannelAdapter
    private var probeJob: Job? = null

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON) // 防休眠
        binding = ActivityMainBinding.inflate(layoutInflater)
        setContentView(binding.root)

        db = Room.databaseBuilder(applicationContext, AppDatabase::class.java, "live_workbench.db")
            .build()

        initPlayer()
        initRecyclerView()
        initListeners()
        observeChannels()
        startProbeLoop()
    }

    private fun initPlayer() {
        exoPlayer = ExoPlayer.Builder(this).build().apply {
            addListener(object : Player.Listener {
                override fun onPlaybackStateChanged(playbackState: Int) {
                    binding.loadingSpinner.visibility =
                        if (playbackState == Player.STATE_BUFFERING) View.VISIBLE else View.GONE
                }

                override fun onPlayerError(error: PlaybackException) {
                    Toast.makeText(this@MainActivity, "播放出错，正在尝试恢复...", Toast.LENGTH_SHORT).show()
                }
            })
        }
        binding.playerView.player = exoPlayer
    }

    private fun initRecyclerView() {
        adapter = ChannelAdapter(
            channelList,
            onItemClick = { channel -> playChannel(channel) },
            onDeleteClick = { channel ->
                lifecycleScope.launch(Dispatchers.IO) { db.channelDao().delete(channel) }
            }
        )
        binding.recyclerView.layoutManager = LinearLayoutManager(this)
        binding.recyclerView.adapter = adapter
    }

    private fun initListeners() {
        binding.btnAdd.setOnClickListener {
            val text = binding.etInput.text.toString()
            if (text.isBlank()) return@setOnClickListener

            binding.btnAdd.isEnabled = false
            lifecycleScope.launch {
                val (rid, isOnce) = DouyinLiveEngine.extractRoomId(text)
                if (rid != null) {
                    val info = DouyinLiveEngine.fetchRoomInfo(rid)
                    val entity = ChannelEntity(
                        rid = rid,
                        name = info?.name ?: "直播间 $rid",
                        title = info?.title ?: "",
                        avatar = info?.avatar ?: "",
                        isLive = info?.isLive ?: false,
                        isOnce = isOnce
                    )
                    withContext(Dispatchers.IO) {
                        db.channelDao().insertOrUpdate(entity)
                    }
                    binding.etInput.text.clear()
                    Toast.makeText(this@MainActivity, "添加成功", Toast.LENGTH_SHORT).show()
                } else {
                    Toast.makeText(this@MainActivity, "无法识别该链接或房间号", Toast.LENGTH_SHORT).show()
                }
                binding.btnAdd.isEnabled = true
            }
        }
    }

    private fun playChannel(channel: ChannelEntity) {
        binding.curName.text = channel.name
        binding.curTitle.text = if (channel.title.isNotEmpty()) channel.title else "房间号: ${channel.rid}"
        Glide.with(this).load(channel.avatar).circleCrop().into(binding.curAvatar)

        binding.loadingSpinner.visibility = View.VISIBLE
        lifecycleScope.launch {
            val liveData = DouyinLiveEngine.fetchRoomInfo(channel.rid)
            if (liveData != null && liveData.isLive && liveData.streamHlsMap.isNotEmpty()) {
                // 优先选取原画或超清
                val playUrl = liveData.streamHlsMap["origin"]
                    ?: liveData.streamHlsMap["uhd"]
                    ?: liveData.streamHlsMap["hd"]
                    ?: liveData.streamHlsMap.values.first()

                exoPlayer?.setMediaItem(MediaItem.fromUri(playUrl))
                exoPlayer?.prepare()
                exoPlayer?.play()
            } else {
                binding.loadingSpinner.visibility = View.GONE
                Toast.makeText(this@MainActivity, "主播未开播或无法拉取流", Toast.LENGTH_SHORT).show()
            }
        }
    }

    private fun observeChannels() {
        lifecycleScope.launch {
            db.channelDao().getAllChannelsFlow().collect { list ->
                channelList.clear()
                channelList.addAll(list)
                adapter.notifyDataSetChanged()
            }
        }
    }

    // 后台 25 秒定时轮询探活与更新
    private fun startProbeLoop() {
        probeJob = lifecycleScope.launch(Dispatchers.IO) {
            while (isActive) {
                channelList.forEach { ch ->
                    val data = DouyinLiveEngine.fetchRoomInfo(ch.rid)
                    if (data != null && (data.isLive != ch.isLive || data.title != ch.title)) {
                        db.channelDao().insertOrUpdate(
                            ch.copy(
                                isLive = data.isLive,
                                title = data.title,
                                avatar = if (data.avatar.isNotEmpty()) data.avatar else ch.avatar,
                                name = if (data.name.isNotEmpty()) data.name else ch.name
                            )
                        )
                    }
                }
                delay(25000)
            }
        }
    }

    override fun onStop() {
        super.onStop()
        exoPlayer?.pause()
    }

    override fun onDestroy() {
        super.onDestroy()
        probeJob?.cancel()
        exoPlayer?.release()
        exoPlayer = null
        // 对应原前端规则：退出时自动清理已下播的一次性房间
        lifecycleScope.launch(Dispatchers.IO) {
            db.channelDao().clearOfflineOnceChannels()
        }
    }
}
