### 五、 核心解析引擎 `DouyinLiveEngine.kt` (移植 `live.php`)

完全重现 PHP 网关中的**口令提纯、短链 302 追踪、注册设备 ttwid、多路结构遍历解析**：

```kotlin
package com.example.douyinlive.engine

import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import okhttp3.MediaType.Companion.toMediaType
import okhttp3.OkHttpClient
import okhttp3.Request
import okhttp3.RequestBody.Companion.toRequestBody
import org.json.JSONObject
import java.net.URLEncoder
import java.util.concurrent.TimeUnit
import java.util.regex.Pattern

data class LiveStreamData(
    val rid: String,
    val isLive: Boolean,
    val name: String,
    val title: String,
    val avatar: String,
    val streamHlsMap: Map<String, String> // 包含 origin, uhd, hd 等级 HLS
)

object DouyinLiveEngine {
    private const val UA_PC = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
    private const val UA_MOBILE = "Mozilla/5.0 (iPhone; CPU iPhone OS 17_4 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148"

    private val httpClient = OkHttpClient.Builder()
        .connectTimeout(5, TimeUnit.SECONDS)
        .readTimeout(8, TimeUnit.SECONDS)
        .build()

    private val noRedirectClient = httpClient.newBuilder()
        .followRedirects(false)
        .followSslRedirects(false)
        .build()

    @Volatile
    private var cachedTtwid: String = ""

    /**
     * 1. 输入文本智能提纯（提取短链、分享文本、网页 URL 或纯房间号）
     */
    suspend fun extractRoomId(rawInput: String): Pair<String?, Boolean> = withContext(Dispatchers.IO) {
        val text = rawInput.trim()
        var isOnce = false

        // 匹配短链接
        val shortMatcher = Pattern.compile("https?://v\\.douyin\\.com/[A-Za-z0-9_-]+/?").matcher(text)
        if (shortMatcher.find()) {
            val shortUrl = shortMatcher.group(0)!!
            val resolved = resolveShortUrl(shortUrl)
            if (resolved != null) return@withContext Pair(resolved, true)
        }

        // 匹配 PC 网页链接
        val webMatcher = Pattern.compile("(?:live\\.douyin\\.com/|follow/live/)(\\d{3,22})").matcher(text)
        if (webMatcher.find()) {
            val rid = webMatcher.group(1)
            return@withContext Pair(rid, (rid?.length ?: 0) >= 15)
        }

        // 匹配纯房间数字
        val numMatcher = Pattern.compile("\\b(\\d{3,22})\\b").matcher(text)
        if (numMatcher.find()) {
            val rid = numMatcher.group(1)
            return@withContext Pair(rid, (rid?.length ?: 0) >= 15)
        }

        Pair(null, false)
    }

    /**
     * 2. 获取并维护全局 ttwid Token (字节防爬通行证)
     */
    private suspend fun getTtwid(): String = withContext(Dispatchers.IO) {
        if (cachedTtwid.isNotEmpty()) return@withContext cachedTtwid
        try {
            val postJson = JSONObject().apply {
                put("region", "cn")
                put("aid", 1768)
                put("needFid", false)
                put("service", "www.ixigua.com")
                put("migrate_info", JSONObject().put("ticket", "").put("source", "node"))
                put("cbUrlProtocol", "https")
                put("union", true)
            }.toString()

            val req = Request.Builder()
                .url("https://ttwid.bytedance.com/ttwid/union/register/")
                .post(postJson.toRequestBody("application/json".toMediaType()))
                .build()

            val res = httpClient.newCall(req).execute()
            val cookie = res.header("Set-Cookie") ?: ""
            val m = Pattern.compile("ttwid=([^;\\s]+)").matcher(cookie)
            if (m.find()) {
                cachedTtwid = m.group(1) ?: ""
            }
        } catch (_: Exception) {}
        cachedTtwid
    }

    /**
     * 3. 追踪短链 302 重定向
     */
    private suspend fun resolveShortUrl(url: String): String? = withContext(Dispatchers.IO) {
        try {
            val req = Request.Builder().url(url).header("User-Agent", UA_MOBILE).build()
            val res = noRedirectClient.newCall(req).execute()
            val loc = res.header("Location") ?: ""
            val m = Pattern.compile("(?:reflow/|room_id=|live\\.douyin\\.com/)(\\d{15,22})").matcher(loc)
            if (m.find()) return@withContext m.group(1)
        } catch (_: Exception) {}
        null
    }

    /**
     * 4. 抓取直播间详情与播放流信息（全版本通用）
     */
    suspend fun fetchRoomInfo(rid: String): LiveStreamData? = withContext(Dispatchers.IO) {
        var isLive = false
        var name = ""
        var title = ""
        var avatar = ""
        val streamMap = mutableMapOf<String, String>()

        // 步骤 4.1：长房间号优先走 reflow 接口解析
        if (rid.length >= 15) {
            try {
                val reflowUrl = "https://webcast.amemv.com/webcast/room/reflow/info/?room_id=${URLEncoder.encode(rid, "UTF-8")}&live_id=1&app_id=1128"
                val req = Request.Builder().url(reflowUrl).header("User-Agent", UA_MOBILE).build()
                val res = httpClient.newCall(req).execute()
                res.body?.string()?.let { parseSnapshot(it, streamMap)?.let { p ->
                    if (p.first.isNotEmpty()) name = p.first
                    if (p.second.isNotEmpty()) title = p.second
                    if (p.third.isNotEmpty()) avatar = p.third
                    if (p.fourth) isLive = true
                }}
            } catch (_: Exception) {}
        }

        // 步骤 4.2：若资料不全或未获流，走 web_enter 补全
        if (!isLive || streamMap.isEmpty() || name.isEmpty()) {
            try {
                val ttwid = getTtwid()
                val webUrl = "https://live.douyin.com/webcast/room/web/enter/?aid=6383&app_name=douyin_web&live_id=1&device_platform=web&language=zh-CN&enter_from=web_live&cookie_enabled=true&screen_width=1920&screen_height=1080&browser_language=zh-CN&browser_platform=Win32&browser_name=Chrome&browser_version=124.0.0.0&web_rid=$rid"
                val req = Request.Builder()
                    .url(webUrl)
                    .header("User-Agent", UA_PC)
                    .header("Referer", "https://live.douyin.com/$rid")
                    .apply { if (ttwid.isNotEmpty()) header("Cookie", "ttwid=$ttwid") }
                    .build()

                val res = httpClient.newCall(req).execute()
                res.body?.string()?.let { parseSnapshot(it, streamMap)?.let { p ->
                    if (p.first.isNotEmpty()) name = p.first
                    if (p.second.isNotEmpty()) title = p.second
                    if (p.third.isNotEmpty()) avatar = p.third
                    if (p.fourth) isLive = true
                }}
            } catch (_: Exception) {}
        }

        if (name.isEmpty() && !isLive) return@withContext null

        LiveStreamData(
            rid = rid,
            isLive = isLive,
            name = if (name.isNotEmpty()) name else "直播间 $rid",
            title = title,
            avatar = avatar,
            streamHlsMap = streamMap
        )
    }

    private fun parseSnapshot(
        jsonStr: String,
        outStreams: MutableMap<String, String>
    ): Quad<String, String, String, Boolean>? {
        return try {
            val root = JSONObject(jsonStr)
            val room = findRoomObject(root) ?: return null
            val owner = room.optJSONObject("owner") ?: room.optJSONObject("anchor")

            val name = owner?.optString("nickname") ?: room.optString("nickname", "")
            val title = room.optString("title", "")
            val avatar = owner?.optJSONObject("avatar_thumb")?.optJSONArray("url_list")?.optString(0) ?: ""
            val status = room.optInt("status", -1)
            val isLive = (status == 2)

            if (isLive) {
                val su = room.optJSONObject("stream_url")
                val streamDataStr = su?.optJSONObject("live_core_sdk_data")?.optJSONObject("pull_data")?.optString("stream_data")
                if (!streamDataStr.isNullOrEmpty()) {
                    val tree = JSONObject(streamDataStr).optJSONObject("data")
                    listOf("origin", "uhd", "hd", "sd").forEach { q ->
                        val hls = tree?.optJSONObject(q)?.optJSONObject("main")?.optString("hls")
                        if (!hls.isNullOrEmpty()) {
                            outStreams[q] = hls.replace("http://", "https://")
                        }
                    }
                }
                if (outStreams.isEmpty()) {
                    val defaultHls = su?.optString("hls_pull_url")
                    if (!defaultHls.isNullOrEmpty()) {
                        outStreams["default"] = defaultHls.replace("http://", "https://")
                    }
                }
            }
            Quad(name, title, avatar, isLive)
        } catch (_: Exception) {
            null
        }
    }

    private fun findRoomObject(root: JSONObject): JSONObject? {
        val paths = arrayOf(
            listOf("data", "room"),
            listOf("data", "data", "0", "room"),
            listOf("data", "data", "0"),
            listOf("room")
        )
        for (path in paths) {
            var curr: Any? = root
            for (p in path) {
                curr = when (curr) {
                    is JSONObject -> curr.opt(p)
                    else -> null
                }
            }
            if (curr is JSONObject && (curr.has("status") || curr.has("owner") || curr.has("stream_url"))) {
                return curr
            }
        }
        return null
    }
}

data class Quad<A, B, C, D>(val first: A, val second: B, val third: C, val fourth: D)
```

